# GamePanel Infrastructure Environment Variables
# Copy this file to .env and customize for your environment

# =============================================================================
# PANEL CONFIGURATION
# =============================================================================
PANEL_DOMAIN=panel.yourdomain.com
PANEL_URL=https://${PANEL_DOMAIN}

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gamepanel
POSTGRES_USER=gamepanel
POSTGRES_PASSWORD=change_me_please

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_please

# =============================================================================
# CADDY CONFIGURATION
# =============================================================================
CADDY_HTTP_BIND=80
CADDY_HTTPS_BIND=443
CADDY_ADMIN_PORT=2019

# =============================================================================
# BEACON / DAEMON CONFIGURATION
# =============================================================================
DAEMON_ADDR=127.0.0.1:9090
DAEMON_SFTP_ADDR=127.0.0.1:2022
DAEMON_SFTP_BIND_ADDR=127.0.0.1:2022
DAEMON_DATA_DIR=/srv/game-panel/servers
DAEMON_BACKUP_DIR=/srv/game-panel/servers/.beacon/backups
BEACON_DATABASE_PATH=/srv/game-panel/servers/.beacon/beacon.db
DAEMON_NODE_ID=replace_with_panel_node_uuid
DAEMON_NODE_TOKEN=replace_with_panel_issued_id.secret
DAEMON_SFTP_HOST_KEY_PASSPHRASE=replace_with_a_separate_32_byte_secret
# Base64 Ed25519 public key used to verify signed remote/self-upgrade metadata.
DAEMON_UPGRADE_PUBLIC_KEY=replace_with_release_signing_public_key
BEACON_UPDATE_PUBLIC_KEY=replace_with_release_signing_public_key
METRICS_TOKEN=replace_with_a_random_32_byte_secret
METRICS_TOKEN_FILE=./.metrics-token
DAEMON_ALLOW_MOCK_RUNTIME=false
DAEMON_ALLOW_INSECURE_NO_AUTH=false
DAEMON_IMAGE=ghcr.io/gamepanel/beacon:replace_with_release_tag
PANEL_API_URL=https://${PANEL_DOMAIN}/api/v1

# =============================================================================
# FORGE API CONFIGURATION
# =============================================================================
FORGE_ADDR=:8080
FORGE_PUBLIC_ADDR=${PANEL_DOMAIN}:8080
FORGE_SECRET=generate_a_strong_secret_here

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
PROMETHEUS_CONFIG=prometheus.yml
GRAFANA_ADMIN_PASSWORD=change_me_please
ALERTMANAGER_CONFIG=alertmanager.yml

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
BACKUP_DIR=/var/backups/gamepanel
S3_ENDPOINT=https://s3.yourprovider.com
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=gamepanel-backups

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
DOCKER_NETWORK=gamepanel_network
DOCKER_VOLUME_DIR=/var/lib/gamepanel

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
JWT_SECRET=generate_a_strong_jwt_secret_here
ENCRYPTION_KEY=generate_a_32_byte_encryption_key_here

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USERNAME=your_email@yourdomain.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=GamePanel <noreply@${PANEL_DOMAIN}>

# =============================================================================
# OPTIONAL: AWS CONFIGURATION
# =============================================================================
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_DEFAULT_REGION=us-east-1

# =============================================================================
# OPTIONAL: GITHUB CONFIGURATION
# =============================================================================
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret
