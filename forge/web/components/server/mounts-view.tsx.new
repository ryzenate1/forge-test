"use client";

import { useMemo, useState } from "react";
import { useQuery, useMutation, useQueryClient } from "@tanstack/react-query";
import { AlertTriangle, Folder, Plus, Trash2 } from "lucide-react";
import { type ApiMount, type ApiServer, fetchServerMounts, fetchMounts, assignMount, removeMount } from "@/lib/api";
import { hasServerPermission, useOptionalServerContext } from "./server-context";
import { errorMessage as message } from "@/lib/utils";
import { EmptyState } from "@/components/ui/primitives";
import { Skeleton } from "@/components/ui/loading-skeleton";
import { useToast } from "@/components/ui/toast";
import { Btn, Modal, ModalFooter } from "@/components/admin/admin-ui";

export function MountsView({ server }: { server: ApiServer }) {
  const ctx = useOptionalServerContext();
  const qc = useQueryClient();
  const { toast } = useToast();
  const access = ctx?.access ?? { user: null, permissions: null, isOwner: false, isAdmin: false };
  const { data: mounts, isLoading, isError, error, refetch } = useQuery<ApiMount[]>({
    queryKey: ["server-mounts", server.id],
    queryFn: () => fetchServerMounts(server.id),
    enabled: hasServerPermission(access, "mount.read"),
  });
  const [showAssign, setShowAssign] = useState(false);
  const [selectedMount, setSelectedMount] = useState<string>("");
  const canAssign = hasServerPermission(access, "mount.create") || access.isAdmin;

  const allMountsQ = useQuery<ApiMount[]>({
    queryKey: ["mounts"],
    queryFn: fetchMounts,
    enabled: showAssign,
    retry: false,
  });

  const assignableMounts = useMemo(() => {
    const all = allMountsQ.data ?? [];
    const attachedIds = new Set((mounts ?? []).map((m) => m.id));
    // Server console: only show mounts that are userMountable unless caller is admin.
    // This wires POST /servers/:id/mounts with eligibility check (handlers_servers.go 2070).
    const filtered = access.isAdmin ? all : all.filter((m) => m.userMountable);
    return filtered.filter((m) => !attachedIds.has(m.id));
  }, [allMountsQ.data, mounts, access.isAdmin]);

  const assignMut = useMutation({
    mutationFn: () => assignMount(server.id, selectedMount),
    onSuccess: () => { qc.invalidateQueries({ queryKey: ["server-mounts", server.id] }); setShowAssign(false); setSelectedMount(""); toast({ tone: "success", title: "Mount assigned" }); },
    onError: (e: Error) => toast({ tone: "error", title: "Assign failed", message: e.message }),
  });
  const removeMut = useMutation({
    mutationFn: (mountId: string) => removeMount(server.id, mountId),
    onSuccess: () => { qc.invalidateQueries({ queryKey: ["server-mounts", server.id] }); toast({ tone: "success", title: "Mount removed" }); },
    onError: (e: Error) => toast({ tone: "error", title: "Remove failed", message: e.message }),
  });

  const isOffline = server.status !== "running" && server.status !== "installing";
  const offlineBanner = isOffline && !server.suspended ? (
    <div className="flex items-start gap-3 rounded-xl border border-slate-500/25 bg-slate-500/10 p-4" role="status">
      <AlertTriangle className="mt-0.5 shrink-0 text-slate-300" size={18} />
      <div>
        <p className="text-sm font-semibold text-slate-200">Server is offline — mounts are read-only</p>
        <p className="mt-1 text-xs leading-5 text-[var(--text-subtle)]">Mount assignments affect the container at next start.</p>
      </div>
    </div>
  ) : null;

  if (isLoading) {
    return <div className="space-y-3">{offlineBanner}<div className="ui-card"><div className="flex items-center justify-between gap-3"><Skeleton className="h-4 w-32" /><Skeleton className="h-5 w-16" /></div><div className="mt-3 space-y-2"><Skeleton className="h-3 w-full" /><Skeleton className="h-3 w-2/3" /></div></div><div className="ui-card"><div className="flex items-center justify-between gap-3"><Skeleton className="h-4 w-40" /><Skeleton className="h-5 w-16" /></div><div className="mt-3 space-y-2"><Skeleton className="h-3 w-full" /><Skeleton className="h-3 w-3/4" /></div></div></div>;
  }
  if (isError) {
    return (
      <div className="space-y-3">{offlineBanner}<div className="ui-card">
        <div className="ui-alert ui-alert-error" role="alert">
          <p className="text-sm">{message(error, "Mounts could not be loaded.")}</p>
          <p className="mt-1 text-xs text-red-300/80">This usually means the daemon is unreachable or the server lacks the mount.read permission. Verify the daemon is online, then retry.</p>
          <button className="ui-button ui-button-secondary mt-3" onClick={() => void refetch()} type="button">Retry</button>
        </div>
      </div></div>
    );
  }
  if (!mounts || mounts.length === 0) {
    return (
      <div className="space-y-3">{offlineBanner}
        <div className="flex items-center justify-between">
          <h2 className="text-lg font-bold text-[var(--text)]">Server Mounts</h2>
          {canAssign && <Btn size="sm" tone="primary" className="bg-[var(--brand)] hover:bg-[var(--brand)]/90 text-white" onClick={() => setShowAssign(true)}><Plus size={12} /> Assign Mount</Btn>}
        </div>
        <EmptyState
          icon={<Folder size={20} />}
          title="No mounts assigned"
          description="This server does not have any mounts configured. Assign one via POST /servers/:id/mounts when userMountable is true, or manage globally in Admin → Mounts."
        />
        {showAssign && (
          <Modal title="Assign Mount — POST /servers/:id/mounts" onClose={() => setShowAssign(false)}>
            <div className="space-y-3">
              {allMountsQ.isLoading ? <p className="text-sm text-slate-400">Loading mounts via fetchMounts (GET /mounts)…</p>
                : assignableMounts.length === 0 ? <p className="text-sm text-slate-400">{access.isAdmin ? "No mounts available." : "No user-mountable mounts available. Admin must mark a mount as User Mountable or assign via Admin → Mounts → Attached Servers."}</p>
                : (
                  <div className="space-y-2 max-h-64 overflow-y-auto">
                    {assignableMounts.map((m) => (
                      <label key={m.id} className={`flex cursor-pointer items-center gap-3 rounded-lg border p-3 text-sm ${selectedMount===m.id ? "border-[var(--brand)]/50 bg-[var(--brand)]/10" : "border-white/10 bg-white/[0.02]"}`}>
                        <input type="radio" name="mount" checked={selectedMount===m.id} onChange={() => setSelectedMount(m.id)} className="accent-[var(--brand)]" />
                        <span className="font-medium text-slate-200">{m.name}</span><span className="font-mono text-xs text-slate-400">{m.source} → {m.target}</span>
                        {m.userMountable && <span className="ml-auto rounded bg-emerald-500/20 px-1.5 py-0.5 text-[10px] text-emerald-300">userMountable</span>}
                      </label>
                    ))}
                  </div>
                )}
              <p className="text-xs text-slate-400">Wires <code className="font-mono">assignMount(serverId, mountId)</code> → POST /servers/:id/mounts. Only userMountable mounts are shown to non-admins.</p>
            </div>
            <ModalFooter onCancel={() => setShowAssign(false)} onConfirm={() => assignMut.mutate()} confirmLabel={assignMut.isPending ? "Assigning…" : "Assign"} disabled={!selectedMount || assignMut.isPending} />
          </Modal>
        )}
      </div>
    );
  }
  return (
    <div className="space-y-3">
      {offlineBanner}
      <div className="flex items-center justify-between">
        <h2 className="text-lg font-bold text-[var(--text)]">Server Mounts</h2>
        {canAssign && <Btn size="sm" tone="primary" className="bg-[var(--brand)] hover:bg-[var(--brand)]/90 text-white" onClick={() => setShowAssign(true)}><Plus size={12} /> Assign Mount</Btn>}
      </div>
      <div className="grid gap-3 sm:grid-cols-2">
        {mounts.map((mount: ApiMount) => (
          <div key={mount.id} className="ui-card">
            <div className="flex items-center justify-between gap-3">
              <h3 className="truncate font-medium text-[var(--text)]">{mount.name}</h3>
              <div className="flex items-center gap-2">
                {mount.userMountable && <span className="rounded-full bg-emerald-500/20 px-2 py-0.5 text-[10px] font-medium text-emerald-300">userMountable</span>}
                {mount.readOnly !== false && <span className="ui-status-pill ui-status-pill-warning">Read-only</span>}
                {canAssign && <button className="rounded p-1 text-red-300 hover:bg-red-500/10" onClick={() => removeMut.mutate(mount.id)} title="Remove via removeMount (DELETE /servers/:id/mounts/:mountId)" type="button"><Trash2 size={14} /></button>}
              </div>
            </div>
            {mount.description && <p className="mt-1 text-xs text-[var(--text-subtle)]">{mount.description}</p>}
            <div className="mt-3 space-y-1 text-xs text-[var(--text-subtle)]">
              <p><span className="text-[var(--text-subtle)]">Source:</span> <code className="font-mono text-slate-300">{mount.source}</code></p>
              <p><span className="text-[var(--text-subtle)]">Target:</span> <code className="font-mono text-slate-300">{mount.target}</code></p>
            </div>
          </div>
        ))}
      </div>
      {showAssign && (
        <Modal title="Assign Mount — POST /servers/:id/mounts" onClose={() => setShowAssign(false)}>
          <div className="space-y-3">
            {allMountsQ.isLoading ? <p className="text-sm text-slate-400">Loading mounts via fetchMounts (GET /mounts)…</p>
              : assignableMounts.length === 0 ? <p className="text-sm text-slate-400">{access.isAdmin ? "No mounts available." : "No user-mountable mounts available."}</p>
              : (
                <div className="space-y-2 max-h-64 overflow-y-auto">
                  {assignableMounts.map((m) => (
                    <label key={m.id} className={`flex cursor-pointer items-center gap-3 rounded-lg border p-3 text-sm ${selectedMount===m.id ? "border-[var(--brand)]/50 bg-[var(--brand)]/10" : "border-white/10 bg-white/[0.02]"}`}>
                      <input type="radio" name="mount" checked={selectedMount===m.id} onChange={() => setSelectedMount(m.id)} className="accent-[var(--brand)]" />
                      <span className="font-medium text-slate-200">{m.name}</span><span className="font-mono text-xs text-slate-400">{m.source} → {m.target}</span>
                    </label>
                  ))}
                </div>
              )}
          </div>
          <ModalFooter onCancel={() => setShowAssign(false)} onConfirm={() => assignMut.mutate()} confirmLabel={assignMut.isPending ? "Assigning…" : "Assign"} disabled={!selectedMount || assignMut.isPending} />
        </Modal>
      )}
    </div>
  );
}
